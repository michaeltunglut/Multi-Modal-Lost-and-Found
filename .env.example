# Mailtrap Email Sending SMTP settings (requires a verified sending domain)
SMTP_HOST=live.smtp.mailtrap.io
SMTP_PORT=587
SMTP_USERNAME=api
SMTP_PASSWORD=your-mailtrap-email-sending-token
SMTP_FROM_EMAIL=lost-found@your-verified-domain.com
SMTP_STARTTLS=1
SMTP_USE_SSL=0

# Public app URL used in the email links
PUBLIC_BASE_URL=http://127.0.0.1:8000
